# 运行选项
HUYA_VERSION=v2
HUYA_GIFT_COUNT=0
HUYA_ROOM_URL=https://www.huya.com/your_room_id
HUYA_DAKA=true
HUYA_WELFARE=true
HUYA_WECHAT_PUSH=auto
HUYA_LOCAL_DEBUG=false

# 登录配置（推荐使用 https://checkin.wwcoder.top 内置虎牙扫码续签自动写入 Secret）
HUYA_COOKIE=
HUYA_COOKIE_FILE=huya_cookie.txt
HUYA_ACCOUNT=
HUYA_PASSWORD=

# 企业微信群机器人 Webhook 推送地址（可选，中枢托管下失败时自动单推告警）
WX_WEBHOOK=

# 集中管控中枢上报配置（https://checkin.wwcoder.top）
CHECKIN_HUB_URL=https://checkin.wwcoder.top
CHECKIN_HUB_TOKEN=
HUB_MANAGED_NOTIFY=true
